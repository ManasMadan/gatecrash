{
  "name": "gatecrash-integration-example",
  "version": "0.1.0",
  "description": "gatecrash integration: appends admissions as NDJSON. Copy me to build your own.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "gatecrash",
    "gatecrash-integration"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
