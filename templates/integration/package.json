  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "gatecrash-client": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "gatecrash-client": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
