node_modules/
dist/

# ...except the placeholder that keeps `internal/webassets` compiling.
#
# The box embeds the built web apps with `go:embed all:dist`, and an empty directory makes that
# pattern fail with "no matching files found". A Go build that cannot succeed without first
# running a JavaScript build is a hostile developer experience — and it broke CI, where the go
# job deliberately does not install Node.
!internal/webassets/dist/
internal/webassets/dist/*
!internal/webassets/dist/.gitkeep
*.tsbuildinfo
.DS_Store
coverage/
docs/.vitepress/cache
docs/.vitepress/dist
*.tgz

# Go build output. The whole product is one static binary; it is built, never
# committed.
/bin/
*.test
*.out

# Box state. A running box writes its database, its minted CA and its event
# keys here; none of it belongs in git, and the keys especially do not.
/var/
*.db
*.db-wal
*.db-shm
*.pem
*.key
!deploy/**/*.example.pem

# Simulator artifacts. Seeds are cheap to rerun and the traces are large.
/sim-out/
*.jsonl.gz

# Android / iOS build output
apps/android/.gradle/
apps/android/build/
apps/android/**/build/
apps/android/local.properties
apps/ios/.build/
apps/ios/**/xcuserdata/
*.xcworkspace/xcuserdata/

# Backstage port build output
apps/backstage-android/.build/
apps/backstage-ios/.build/

# Stray build outputs at the repo root. `go build ./cmd/...` without -o drops binaries here,
# and an 18MB blob is an easy thing to commit by accident.
/gatecrash
/gatecrash-keys
/gatecrash-sim
/gatecrash-demo
