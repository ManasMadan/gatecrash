{
  "name": "@gatecrash/ui",
  "version": "0.1.0",
  "description": "Design tokens, the gate verdict screen, and the venue map renderer. Shared by the scanner, the attendee wallet and the dashboard.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManasMadan/gatecrash.git",
    "directory": "packages/ui"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@gatecrash/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
