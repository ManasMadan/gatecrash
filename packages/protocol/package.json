{
  "name": "gatecrash-client",
  "version": "0.1.0",
  "description": "Wire types, QR codecs and the box's API client. Shared by the scanner, the attendee wallet and the dashboard.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "gatecrash",
    "ticketing",
    "offline-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManasMadan/gatecrash.git",
    "directory": "packages/protocol"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
